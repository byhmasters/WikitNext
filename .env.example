# Copy to .env and fill in.
#
# Local development (Docker container `wkt-postgres`):
DATABASE_URL=postgres://wikit:wikit@localhost:5432/wikit
#
# Managed Postgres (Neon / Supabase / Railway / your own) — note sslmode=require:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB?sslmode=require
#
# On Vercel you usually don't set this: linking a Vercel Postgres injects
# POSTGRES_URL automatically, which the app also reads.
